{
  "name": "claude-clone",
  "version": "0.1.0",
  "description": "Noni — a terminal coding agent with web search, docs guard, nested todos and background jobs.",
  "type": "module",
  "module": "index.ts",
  "bin": {
    "claude-clone": "bin/claude-clone.js"
  },
  "files": [
    "bin",
    "index.ts",
    "src",
    "README.md",
    "TOOLS.md"
  ],
  "scripts": {
    "dev": "bun run --watch index.ts",
    "start": "bun index.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun test"
  },
  "keywords": [
    "cli",
    "ai",
    "agent",
    "tui",
    "ollama",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hassaammgl/claude-clone.git"
  },
  "bugs": {
    "url": "https://github.com/hassaammgl/claude-clone/issues"
  },
  "homepage": "https://github.com/hassaammgl/claude-clone#readme",
  "engines": {
    "node": ">=18",
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "ollama": "^0.6.4"
  }
}
